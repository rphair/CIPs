{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://github.com/cardano-foundation/CIPs/blob/master/CIP-XXXX/registry.schema.json",
  "title": "Node Implementation Identifier Registry",
  "description": "Identifiers carried in the block header protocol_version minor component. Entries are unique by (scheme, id).",
  "type": "array",
  "items": {
    "type": "object",
    "properties": {
      "scheme": {
        "type": "integer",
        "minimum": 0,
        "maximum": 3
      },
      "id": {
        "type": "integer",
        "minimum": 0,
        "maximum": 255
      },
      "name": {
        "type": "string",
        "maxLength": 64
      },
      "status": {
        "type": "string",
        "enum": ["active", "retired", "reserved"]
      },
      "maintainer": {
        "type": "string",
        "maxLength": 128
      },
      "repository": {
        "type": ["string", "null"],
        "format": "uri"
      },
      "payload_specification": {
        "type": ["string", "null"],
        "format": "uri"
      },
      "registered": {
        "type": "string",
        "format": "date"
      },
      "retired": {
        "type": ["string", "null"],
        "format": "date"
      },
      "description": {
        "type": "string",
        "maxLength": 256
      }
    },
    "required": ["scheme", "id", "name", "status", "registered", "description"],
    "additionalProperties": false
  }
}
